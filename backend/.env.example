# CrimeShield AI — Backend Environment Variables
# ================================================
# Copy this file to .env and fill in your values.
# The backend reads these at startup.

# PostgreSQL + PostGIS connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crimeshield

# If you're using Supabase (free hosted PostgreSQL with PostGIS):
# DATABASE_URL=postgresql://postgres:YOUR_SUPABASE_PASSWORD@db.xxxx.supabase.co:5432/postgres

# If running in Docker:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/crimeshield
